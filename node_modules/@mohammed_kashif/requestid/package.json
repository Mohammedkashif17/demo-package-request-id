{
  "name": "@mohammed_kashif/requestid",
  "version": "1.0.0",
  "description": "Lightweight, configurable Express.js middleware that automatically generates, validates, manages, and propagates unique HTTP request identifiers.",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "express",
    "middleware",
    "request-id",
    "uuid",
    "nanoid",
    "request-tracking",
    "logging",
    "microservices",
    "rest-api",
    "correlation-id",
    "tracing",
    "http"
  ],
  "author": "Mohammed Kashif <mohammedkashif374@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run --reporter=verbose",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/vitest",
    "lint": "eslint src tests examples",
    "lint:fix": "eslint src tests examples --fix",
    "validate": "npm run lint && npm test",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohammedkashif17/requestid.git"
  },
  "bugs": {
    "url": "https://github.com/Mohammedkashif17/requestid/issues"
  },
  "homepage": "https://github.com/Mohammedkashif17/requestid#readme"
}
